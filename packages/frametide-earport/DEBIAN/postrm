#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    rm -f /usr/share/gnome-shell/extensions/earport@anoryth.github.io/schemas/gschemas.compiled
    rmdir --ignore-fail-on-non-empty /usr/share/gnome-shell/extensions/earport@anoryth.github.io/schemas \
        /usr/share/gnome-shell/extensions/earport@anoryth.github.io 2>/dev/null || true
fi
