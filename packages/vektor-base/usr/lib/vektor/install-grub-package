#!/bin/sh
# Wird vom Installer im Zielsystem aufgerufen (siehe Calamares shellprocess@grubpkg).
set -e
cache=/var/cache/vektor/grub
export DEBIAN_FRONTEND=noninteractive
if [ -d /sys/firmware/efi ]; then
    pkgs="grub-efi-amd64"
else
    pkgs="grub-pc"
fi
for p in $pkgs; do
    dpkg -i "$cache"/"${p}"_*.deb
done
rm -rf "$cache"
