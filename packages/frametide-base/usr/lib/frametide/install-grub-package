#!/bin/sh
# Wird vom Installer im Zielsystem aufgerufen (siehe Calamares shellprocess@grubpkg).
# Installiert das zum Startmodus passende GRUB-Paket samt Abhängigkeiten aus dem Offline-Cache.
set -e
cache=/var/cache/frametide/grub
export DEBIAN_FRONTEND=noninteractive
mode="${FRAMETIDE_BOOT_MODE:-}"  # nur für Tests: efi oder pc erzwingen
if [ -z "$mode" ]; then
    if [ -d /sys/firmware/efi ]; then mode=efi; else mode=pc; fi
fi
set -- "$cache/$mode"/*.deb
if [ -e "$1" ]; then
    dpkg -i "$@"
fi
rm -rf "$cache"
