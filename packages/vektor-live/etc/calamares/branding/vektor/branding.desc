---
componentName: vektor
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 1024px,640px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "Vektor OS"
    shortProductName:    "Vektor"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Vektor OS @VERSION@ „@CODENAME_PRETTY@“"
    shortVersionedName:  "Vektor @VERSION@"
    bootloaderEntryName: "Vektor OS"
    productUrl:          "@URL@"
    supportUrl:          "@URL@/issues"
    knownIssuesUrl:      "@URL@/issues"

images:
    productLogo:         "logo.svg"
    productIcon:         "logo.svg"
    productWelcome:      "logo.svg"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:        "#090C14"
   SidebarText:              "#E6EAF2"
   SidebarTextCurrent:       "#090C14"
   SidebarBackgroundCurrent: "#19E3D1"
