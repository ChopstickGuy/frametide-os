#!/bin/sh
# Prüft vor dem Entpacken, ob das Installationsziel eine echte, große genug Partition ist.
root="$1"
if ! mountpoint -q "$root"; then
    echo "Es wurde keine Partition für das System festgelegt."
    echo ""
    echo "Bitte den Installer neu starten und im Schritt „Partitionen“ „Festplatte löschen“ wählen –"
    echo "dann legt der Installer alles automatisch an."
    echo ""
    echo "Bei „Manueller Partitionierung“ braucht es eine Partition mit dem Einhängepunkt „/“ (ext4)"
    echo "und bei UEFI zusätzlich eine FAT32-Partition mit dem Einhängepunkt „/boot/efi“."
    exit 1
fi
avail_kb=$(df -Pk "$root" | awk 'NR==2 {print $4}')
if [ "${avail_kb:-0}" -lt 15000000 ]; then
    echo "Die Systempartition ist zu klein: $((avail_kb / 1024 / 1024)) GB frei, mindestens 15 GB nötig."
    exit 1
fi
echo "Ziel in Ordnung: $(findmnt -no SOURCE,FSTYPE "$root"), $((avail_kb / 1024 / 1024)) GB frei"
