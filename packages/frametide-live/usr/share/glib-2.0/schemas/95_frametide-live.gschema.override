# Nur im Live-System: Installer ganz vorne im Dock
[org.gnome.shell]
favorite-apps=['frametide-install.desktop','firefox.desktop','org.gnome.Nautilus.desktop','org.gnome.Ptyxis.desktop','org.gnome.Settings.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['frametide-install.desktop','firefox.desktop','org.gnome.Nautilus.desktop','org.gnome.Ptyxis.desktop','org.gnome.Settings.desktop']

[org.gnome.desktop.screensaver:ubuntu]
lock-enabled=false

[org.gnome.desktop.background:ubuntu]
picture-uri-dark='file:///usr/share/backgrounds/frametide/frametide-tide-logo.svg'
picture-uri='file:///usr/share/backgrounds/frametide/frametide-tide-logo.svg'
