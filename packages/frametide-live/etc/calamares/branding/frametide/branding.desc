---
componentName: frametide
welcomeStyleCalamares: false
welcomeExpandingLogo: false
windowExpanding: normal
windowSize: 1100px,700px
windowPlacement: center
sidebar: qml
navigation: widget

strings:
    productName:         "Frametide OS"
    shortProductName:    "Frametide"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Frametide OS @VERSION@ „@CODENAME_PRETTY@“"
    shortVersionedName:  "Frametide @VERSION@"
    bootloaderEntryName: "Frametide OS"
    productUrl:          "@URL@"
    supportUrl:          "@URL@/issues"
    knownIssuesUrl:      "@URL@/issues"

images:
    productLogo:         "logo-icon.svg"
    productIcon:         "logo-icon.svg"
    productWelcome:      "wordmark.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:        "#0A0D18"
   SidebarText:              "#7D879C"
   SidebarTextCurrent:       "#F3F6FD"
   SidebarBackgroundCurrent: "#16384A"
