---
componentName: frametide
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 1024px,640px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         "Frametide OS"
    shortProductName:    "Frametide"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Frametide OS @VERSION@ „@CODENAME_PRETTY@“"
    shortVersionedName:  "Frametide @VERSION@"
    bootloaderEntryName: "Frametide OS"
    productUrl:          "@URL@"
    supportUrl:          "@URL@/issues"
    knownIssuesUrl:      "@URL@/issues"

images:
    productLogo:         "logo-icon.svg"
    productIcon:         "logo-icon.svg"
    productWelcome:      "logo-icon.svg"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:        "#05070F"
   SidebarText:              "#E6EAF2"
   SidebarTextCurrent:       "#05070F"
   SidebarBackgroundCurrent: "#22D3EE"
