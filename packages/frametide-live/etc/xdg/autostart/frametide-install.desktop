[Desktop Entry]
Type=Application
Name=Install Frametide OS
Name[de]=Frametide OS installieren
Comment=Install Frametide OS on this computer
Comment[de]=Frametide OS auf diesem Computer installieren
Exec=/usr/lib/frametide/start-installer
Icon=frametide-logo
Terminal=false
StartupWMClass=calamares
X-GNOME-Autostart-Delay=2
