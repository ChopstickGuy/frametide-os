Keywords[de]=update;treiber;nvidia;amd;rgb;lüfter;
StartupNotify=true
Actions=updates;drivers;audio;hardware;

[Desktop Action updates]
Name=Updates
Exec=frametide-center updates

[Desktop Action drivers]
Name=Drivers
Name[de]=Treiber
Exec=frametide-center drivers

