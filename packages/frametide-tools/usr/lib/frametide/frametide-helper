#!/usr/bin/python3 -I
"""frametide-helper – privilegierte Aktionen für Store und Center.

Wird ausschließlich per pkexec aufgerufen (Polkit-Aktion org.frametide.helper)
und führt nur fest definierte, geprüfte Befehle aus – keine beliebigen Kommandos.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request

CRAFT_REPOS = {
    "wordcraft": "wordcraft", "gridcraft": "gridcraft", "deckcraft": "deckcraft",
    "pdfcraft": "pdfcraft", "photocraft": "photocraft", "lightcraft": "lightcraft",
    "vectorcraft": "vectorcraft", "filmcraft": "filmcraft", "effectcraft": "effectcraft",
    "soundcraft": "soundcraft", "designcraft": "designcraft", "figcraft": "figcraft",
    "cadcraft": "cadcraft", "artcraft-launcher": "craft-launcher",
}
# Hersteller-Pakete (.deb von der offiziellen Adresse; der Paketname wird geprüft)
VENDOR_DEBS = {
    "curseforge": ("https://curseforge.overwolf.com/downloads/curseforge-latest-linux.deb", "curseforge"),
}
# Werkzeuge aus GitHub-Releases (SHA256-geprüft, nur die erwartete Programmdatei wird entpackt)
GITHUB_TOOLS = {
    "net-merge": {"repo": "rohit267/net-merge", "asset": r"-linux-x86_64\.tar\.gz$", "binary": "net-merge",
                  "caps": "cap_net_admin,cap_net_raw+ep", "exec": "net-merge tray",
                  "name": "net-merge", "comment": "Alle Internetverbindungen gleichzeitig nutzen",
                  "icon": "network-transmit-receive"},
}
TOOLS_DIR = "/opt/frametide/tools"
LOCAL_BIN = "/usr/local/bin"
LOCAL_APPS = "/usr/local/share/applications"
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9+.-]{1,80}(:i386)?$")
DRIVER_RE = re.compile(r"^nvidia-driver-(\d+)(-open|-server|-server-open)?$")
FAN_DRIVERS = {"it87-dkms", "nct6687d-dkms"}
OPTIONS = {"AMD64V3", "AMD_OVERDRIVE", "SMBUS_LAX", "MITIGATIONS_OFF", "AC_PERFORMANCE"}
CONF = "/etc/frametide/hwsetup.conf"
# Optionale neueste Mesa-Treiber (Kisak-PPA, enthält auch 32-Bit-Pakete für Steam)
MESA_SOURCE = "/etc/apt/sources.list.d/frametide-mesa-latest.sources"
MESA_KEY = "/usr/share/frametide/keyrings/kisak-mesa.gpg"
MESA_URL = "https://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu"
MESA_PIN = "/etc/apt/preferences.d/frametide-mesa-revert"
APT = ["apt-get", "-y", "-o", "DPkg::Lock::Timeout=300", "-o", "Dpkg::Options::=--force-confold",
       "-o", "APT::Status-Fd=1"]  # Fortschritt als "dlstatus:/pmstatus:" für Store und Center
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "DEBIAN_FRONTEND": "noninteractive", "LANG": "C.UTF-8"}


ENGLISH = False
EN = {
    "neueste Version wird ermittelt": "looking up latest version",
    "ist aktuell": "is up to date",
    "wird heruntergeladen": "downloading",
    "Prüfsumme OK, wird installiert": "checksum OK, installing",
    "Paketquellen werden aktualisiert": "Refreshing package sources",
    "System-Pakete werden aktualisiert": "Updating system packages",
    "Flatpak-Apps werden aktualisiert": "Updating Flatpak apps",
    "ArtCraft-Apps werden aktualisiert": "Updating ArtCraft apps",
    "Wird installiert": "Installing",
    "Wird entfernt": "Removing",
    "NVIDIA-Treiber wird installiert": "Installing NVIDIA driver",
    "Fertig – bitte neu starten": "Done – please restart",
    "wird installiert (bei Secure Boot fragt der nächste Start nach dem MOK-Passwort)":
        "installing (with Secure Boot the next boot asks for the MOK password)",
    "Firmware-Updates (fwupd)": "Firmware updates (fwupd)",
    "gespeichert, Einstellungen werden angewendet": "saved, applying settings",
    "Fertig": "Done",
    "wird aktualisiert": "updating",
    "Neueste Mesa-Treiber werden eingerichtet": "Setting up latest Mesa drivers",
    "Mesa-Treiber von Ubuntu werden wiederhergestellt": "Restoring Ubuntu's Mesa drivers",
}


def t(text):
    return EN.get(text, text) if ENGLISH else text


def say(*parts):
    """Statuszeile; Teile in t() werden übersetzt, Namen/Versionen bleiben."""
    print("» " + " ".join(parts), flush=True)


def run(argv, check=True):
    proc = subprocess.run(argv, env=ENV)
    if check and proc.returncode != 0:
        raise SystemExit(f"Fehlgeschlagen ({proc.returncode}): {' '.join(argv)}")
    return proc.returncode


def packages(args):
    bad = [p for p in args if not PKG_RE.match(p)]
    if not args or bad:
        raise SystemExit(f"Ungültige Paketnamen: {' '.join(bad) or '(keine)'}")
    return args


def is_newer(app, version):
    current = subprocess.run(["dpkg-query", "-W", "-f=${Version}", app],
                             capture_output=True, text=True).stdout.split("-")[0]
    return not current or subprocess.run(["dpkg", "--compare-versions", version, "gt", current]).returncode == 0


def craft_install(apps, only_newer=False):
    for app in apps:
        if app not in CRAFT_REPOS:
            raise SystemExit(f"Unbekannte Craft-App: {app}")
        say(f"{app}:", t("neueste Version wird ermittelt"))
        url = f"https://api.github.com/repos/storytold/{CRAFT_REPOS[app]}/releases/latest"
        with urllib.request.urlopen(url, timeout=30) as r:
            release = json.load(r)
        asset = next(a for a in release["assets"] if a["name"].endswith("-linux-x86_64.deb"))
        if only_newer and not is_newer(app, release["tag_name"].lstrip("v")):
            say(app, t("ist aktuell"))
            continue
        expected = (asset.get("digest") or "").removeprefix("sha256:")
        if not expected:
            raise SystemExit(f"{app}: keine Prüfsumme veröffentlicht – Abbruch")
        if not asset["browser_download_url"].startswith("https://github.com/storytold/"):
            raise SystemExit(f"{app}: unerwartete Download-Adresse")
        with tempfile.TemporaryDirectory() as tmp:
            path = os.path.join(tmp, asset["name"])
            say(app, release["tag_name"], t("wird heruntergeladen"), f"({asset['size'] // 1_000_000} MB)")
            last = [-1]

            def progress(blocks, block_size, total):
                pct = min(100, blocks * block_size * 100 // total) if total > 0 else 0
                if pct >= last[0] + 5:
                    last[0] = pct
                    print(f"dlstatus:{app}:{pct}:download", flush=True)
            urllib.request.urlretrieve(asset["browser_download_url"], path, progress)
            with open(path, "rb") as f:
                actual = hashlib.sha256(f.read()).hexdigest()
            if actual != expected:
                raise SystemExit(f"{app}: Prüfsumme stimmt nicht – Download verworfen")
            say(f"{app}:", t("Prüfsumme OK, wird installiert"))
            os.chmod(tmp, 0o755)
            run(APT + ["install", path])


def craft_installed():
    out = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n", *CRAFT_REPOS],
                         capture_output=True, text=True).stdout
    return [line.split()[0] for line in out.splitlines() if line.split()[1:2] == ["ii"]]


def vendor_install(app_id):
    if app_id not in VENDOR_DEBS:
        raise SystemExit(f"Unbekanntes Hersteller-Paket: {app_id}")
    url, expected = VENDOR_DEBS[app_id]
    with tempfile.TemporaryDirectory() as tmp:
        os.chmod(tmp, 0o755)
        path = os.path.join(tmp, f"{app_id}.deb")
        say(app_id, t("wird heruntergeladen"))
        last = [-1]

        def progress(blocks, block_size, total):
            pct = min(100, blocks * block_size * 100 // total) if total > 0 else 0
            if pct >= last[0] + 5:
                last[0] = pct
                print(f"dlstatus:{app_id}:{pct}:download", flush=True)
        urllib.request.urlretrieve(url, path, progress)
        name = subprocess.run(["dpkg-deb", "-f", path, "Package"], capture_output=True, text=True).stdout.strip()
        if name != expected:
            raise SystemExit(f"{app_id}: unerwartetes Paket „{name}“ – Abbruch")
        run(APT + ["install", path])


def github_tool_install(tool_id, only_newer=False):
    import tarfile
    if tool_id not in GITHUB_TOOLS:
        raise SystemExit(f"Unbekanntes Werkzeug: {tool_id}")
    tool = GITHUB_TOOLS[tool_id]
    with urllib.request.urlopen(f"https://api.github.com/repos/{tool['repo']}/releases/latest", timeout=30) as r:
        release = json.load(r)
    version = release["tag_name"].lstrip("v")
    version_file = os.path.join(TOOLS_DIR, tool_id, "VERSION")
    if only_newer and os.path.exists(version_file) and open(version_file).read().strip() == version:
        say(tool_id, t("ist aktuell"))
        return
    asset = next(a for a in release["assets"] if re.search(tool["asset"], a["name"]))
    expected = (asset.get("digest") or "").removeprefix("sha256:")
    if not expected or not asset["browser_download_url"].startswith(f"https://github.com/{tool['repo']}/"):
        raise SystemExit(f"{tool_id}: keine Prüfsumme oder unerwartete Adresse – Abbruch")
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, asset["name"])
        say(tool_id, release["tag_name"], t("wird heruntergeladen"))
        urllib.request.urlretrieve(asset["browser_download_url"], path)
        with open(path, "rb") as f:
            if hashlib.sha256(f.read()).hexdigest() != expected:
                raise SystemExit(f"{tool_id}: Prüfsumme stimmt nicht – Download verworfen")
        say(f"{tool_id}:", t("Prüfsumme OK, wird installiert"))
        with tarfile.open(path) as tar:
            member = next(m for m in tar.getmembers()
                          if m.isfile() and os.path.basename(m.name) == tool["binary"])
            data = tar.extractfile(member).read()
    target_dir = os.path.join(TOOLS_DIR, tool_id)
    os.makedirs(target_dir, exist_ok=True)
    binary = os.path.join(target_dir, tool["binary"])
    with open(binary + ".new", "wb") as f:
        f.write(data)
    os.chmod(binary + ".new", 0o755)
    os.replace(binary + ".new", binary)
    if tool.get("caps"):
        run(["setcap", tool["caps"], binary])
    link = os.path.join(LOCAL_BIN, tool["binary"])
    if os.path.islink(link) or not os.path.exists(link):
        if os.path.islink(link):
            os.remove(link)
        os.symlink(binary, link)
    os.makedirs(LOCAL_APPS, exist_ok=True)
    with open(os.path.join(LOCAL_APPS, f"frametide-tool-{tool_id}.desktop"), "w") as f:
        f.write(f"[Desktop Entry]\nType=Application\nName={tool['name']}\nComment={tool['comment']}\n"
                f"Exec={tool['exec']}\nIcon={tool['icon']}\nTerminal=false\nCategories=Network;\n")
    with open(version_file, "w") as f:
        f.write(version + "\n")


def github_tool_remove(tool_id):
    if tool_id not in GITHUB_TOOLS:
        raise SystemExit(f"Unbekanntes Werkzeug: {tool_id}")
    tool = GITHUB_TOOLS[tool_id]
    link = os.path.join(LOCAL_BIN, tool["binary"])
    if os.path.islink(link):
        os.remove(link)
    for path in (os.path.join(LOCAL_APPS, f"frametide-tool-{tool_id}.desktop"),):
        if os.path.exists(path):
            os.remove(path)
    import shutil
    shutil.rmtree(os.path.join(TOOLS_DIR, tool_id), ignore_errors=True)


def set_option(key, value):
    if key not in OPTIONS or value not in ("yes", "no"):
        raise SystemExit("Ungültige Option")
    lines = open(CONF).read().splitlines() if os.path.exists(CONF) else []
    lines = [l for l in lines if not l.startswith(f"{key}=")] + [f"{key}={value}"]
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("\n".join(lines) + "\n")
    say(f"{key}={value}", t("gespeichert, Einstellungen werden angewendet"))
    if key == "AC_PERFORMANCE":  # nur das Energieprofil, kein Treiber-Durchlauf
        if value == "no":
            run(["powerprofilesctl", "set", "balanced"], check=False)
        run(["systemctl", "start", "frametide-power-profile.service"], check=False)
        return
    run(["/usr/sbin/frametide-hwsetup", "--apply"])


def ubuntu_codename():
    for line in open("/etc/os-release"):
        if line.startswith("UBUNTU_CODENAME="):
            return line.split("=", 1)[1].strip().strip('"')
    raise SystemExit("UBUNTU_CODENAME fehlt in /etc/os-release")


def mesa_latest(enable):
    """Neueste Mesa-Version (Kisak-PPA) ein- oder ausschalten. Beim Ausschalten werden alle
    Pakete aus der PPA auf die Ubuntu-Version zurückgesetzt."""
    if enable:
        say(t("Neueste Mesa-Treiber werden eingerichtet"))
        with open(MESA_SOURCE, "w") as f:
            f.write("# Frametide: neueste Mesa-Treiber (Steuerung → Treiber)\n"
                    f"Types: deb\nURIs: {MESA_URL}\nSuites: {ubuntu_codename()}\nComponents: main\n"
                    f"Signed-By: {MESA_KEY}\n")
        run(["apt-get", "-o", "DPkg::Lock::Timeout=300", "update"])
        run(APT + ["full-upgrade"])
        return
    say(t("Mesa-Treiber von Ubuntu werden wiederhergestellt"))
    out = subprocess.run(["dpkg-query", "-W", "-f=${Package}\t${Version}\n"],
                         capture_output=True, text=True, env=ENV).stdout
    kisak = sorted({line.split("\t")[0] for line in out.splitlines() if "kisak" in line})
    if os.path.exists(MESA_SOURCE):
        os.remove(MESA_SOURCE)
    if kisak:
        with open(MESA_PIN, "w") as f:
            f.write(f"Package: {' '.join(kisak)}\nPin: release o=Ubuntu\nPin-Priority: 1001\n")
    try:
        run(["apt-get", "-o", "DPkg::Lock::Timeout=300", "update"])
        if kisak:
            run(APT + ["--allow-downgrades", "full-upgrade"])
    finally:
        if os.path.exists(MESA_PIN):
            os.remove(MESA_PIN)


def main(argv):
    if os.geteuid() != 0:
        raise SystemExit("frametide-helper muss über pkexec laufen")
    global ENGLISH
    if argv and argv[0].startswith("--lang="):
        ENGLISH = argv.pop(0) != "--lang=de"
    if not argv:
        raise SystemExit(__doc__)
    cmd, args = argv[0], argv[1:]

    if cmd == "refresh":
        say(t("Paketquellen werden aktualisiert"))
        run(["apt-get", "-o", "DPkg::Lock::Timeout=300", "update"])
        run(["flatpak", "update", "--appstream", "--system"], check=False)
    elif cmd == "upgrade":
        say(t("System-Pakete werden aktualisiert"))
        run(["apt-get", "-o", "DPkg::Lock::Timeout=300", "update"])
        run(APT + ["full-upgrade"])
        say(t("Flatpak-Apps werden aktualisiert"))
        run(["flatpak", "update", "-y", "--noninteractive", "--system"], check=False)
        if craft_installed():
            say(t("ArtCraft-Apps werden aktualisiert"))
            craft_install(craft_installed(), only_newer=True)
        for tool_id in GITHUB_TOOLS:
            if os.path.exists(os.path.join(TOOLS_DIR, tool_id, "VERSION")):
                say(tool_id, t("wird aktualisiert"))
                github_tool_install(tool_id, only_newer=True)
        run(APT + ["autoremove", "--purge"], check=False)
    elif cmd == "install":
        say(t("Wird installiert") + ":", *args)
        names = packages(args)
        # Paket noch nicht in der lokalen Liste (z. B. neu in der Frametide-Quelle)? Erst abgleichen.
        policy = subprocess.run(["apt-cache", "policy", *names], capture_output=True, text=True, env=ENV).stdout
        known = {line[:-1] for line in policy.splitlines() if line.endswith(":") and not line.startswith(" ")}
        if "Candidate: (none)" in policy or not set(names) <= known:
            run(["apt-get", "-o", "DPkg::Lock::Timeout=300", "update"])
        run(APT + ["install", *names])
    elif cmd == "remove":
        say(t("Wird entfernt") + ":", *args)
        run(APT + ["remove", *packages(args)])
    elif cmd == "craft-install":
        craft_install(args)
    elif cmd == "vendor-install" and len(args) == 1:
        vendor_install(args[0])
    elif cmd == "tool-install" and len(args) == 1:
        github_tool_install(args[0])
    elif cmd == "tool-remove" and len(args) == 1:
        github_tool_remove(args[0])
    elif cmd == "driver-install":
        m = DRIVER_RE.match(args[0]) if len(args) == 1 else None
        if not m:
            raise SystemExit("Ungültiger Treiber")
        say(t("NVIDIA-Treiber wird installiert") + ":", args[0])
        run(APT + ["install", args[0], f"libnvidia-gl-{m.group(1)}:i386"])
        say(t("Fertig – bitte neu starten"))
    elif cmd == "driver-auto":
        run(["/usr/sbin/frametide-hwsetup", "--apply"])
    elif cmd == "fan-driver":
        if len(args) != 1 or args[0] not in FAN_DRIVERS:
            raise SystemExit("Ungültiger Lüftertreiber")
        say(args[0], t("wird installiert (bei Secure Boot fragt der nächste Start nach dem MOK-Passwort)"))
        run(APT + ["install", args[0]])
        run(["sensors-detect", "--auto"], check=False)
    elif cmd == "sensors-detect":
        run(["sensors-detect", "--auto"], check=False)
    elif cmd == "firmware-update":
        say(t("Firmware-Updates (fwupd)"))
        run(["fwupdmgr", "refresh", "--force"], check=False)
        run(["fwupdmgr", "update", "-y", "--no-reboot-check"], check=False)
    elif cmd == "mesa-latest" and args in (["on"], ["off"]):
        mesa_latest(args[0] == "on")
    elif cmd == "set-option" and len(args) == 2:
        set_option(*args)
    else:
        raise SystemExit(f"Unbekannter Befehl: {cmd}")
    say(t("Fertig"))


if __name__ == "__main__":
    main(sys.argv[1:])
