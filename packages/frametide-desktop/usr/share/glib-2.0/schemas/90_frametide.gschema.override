# Frametide OS – Standard-Design: dunkel, ruhig, aufgeräumt.
# Ubuntu setzt Werte auch sitzungsspezifisch ([…:ubuntu]) – die haben Vorrang, daher jede Gruppe doppelt.

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='teal'
gtk-theme='Yaru-prussiangreen-dark'
icon-theme='Papirus-Dark'
font-name='Inter Variable 11'
document-font-name='Inter Variable 11'
monospace-font-name='JetBrains Mono 11'
enable-hot-corners=false
show-battery-percentage=true
clock-format='24h'
clock-show-weekday=true

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Inter Variable Bold 11'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/frametide/frametide-tide-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/frametide/frametide-tide-dark.svg'
primary-color='#05070F'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/frametide/frametide-tide-dark.svg'
primary-color='#05070F'

[org.gnome.desktop.peripherals.mouse]
accel-profile='flat'

[org.gnome.desktop.sound]
theme-name='frametide'
event-sounds=true
input-feedback-sounds=false

[org.gnome.desktop.notifications]
show-in-lock-screen=false

[org.gnome.mutter]
experimental-features=['variable-refresh-rate','scale-monitor-framebuffer','xwayland-native-scaling']
check-alive-timeout=uint32 20000

[org.gnome.shell]
favorite-apps=['firefox.desktop','org.gnome.Nautilus.desktop','steam.desktop','net.lutris.Lutris.desktop','org.gnome.Ptyxis.desktop','org.gnome.Software.desktop','org.gnome.Settings.desktop']
disabled-extensions=['ding@rastersoft.com','web-search-provider@ubuntu.com','snapd-prompting@canonical.com','snapd-search-provider@canonical.com']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
dash-max-icon-size=44
transparency-mode='DYNAMIC'
running-indicator-style='DOTS'
show-trash=false
show-mounts=false
show-apps-at-top=false
click-action='minimize-or-previews'

[org.gnome.nautilus.preferences]
default-folder-viewer='icon-view'
show-delete-permanently=true


[org.gnome.desktop.interface:ubuntu]
color-scheme='prefer-dark'
accent-color='teal'
gtk-theme='Yaru-prussiangreen-dark'
icon-theme='Papirus-Dark'
