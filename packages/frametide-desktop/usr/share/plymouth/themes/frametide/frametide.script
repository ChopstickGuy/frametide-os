# Frametide OS – Startbildschirm (Plymouth script)
# Wallpaper als Hintergrund, großes Logo, darunter die kreisende Welle,
# unten dezent „basiert auf Ubuntu“.

Window.SetBackgroundTopColor(0.02, 0.03, 0.06);
Window.SetBackgroundBottomColor(0.02, 0.03, 0.06);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# --- Hintergrund: Wallpaper bildschirmfüllend (wie „zoom“)
bg_image = Image("background.png");
bg_scale = Math.Max(screen_w / bg_image.GetWidth(), screen_h / bg_image.GetHeight());
bg_w = Math.Int(bg_image.GetWidth() * bg_scale);
bg_h = Math.Int(bg_image.GetHeight() * bg_scale);
bg = Sprite(bg_image.Scale(bg_w, bg_h));
bg.SetX(Math.Int((screen_w - bg_w) / 2));
bg.SetY(Math.Int((screen_h - bg_h) / 2));
bg.SetZ(-100);

# --- Logo (auf kleinen Bildschirmen etwas kleiner)
logo_image = Image("logo.png");
logo_size = Math.Min(200, Math.Int(screen_h * 0.22));
logo_image = logo_image.Scale(logo_size, logo_size);
logo = Sprite(logo_image);
logo_x = Math.Int(screen_w / 2 - logo_size / 2);
logo_y = Math.Int(screen_h * 0.34 - logo_size / 2);
logo.SetX(logo_x);
logo.SetY(logo_y);
logo.SetZ(10);

# --- Wellen-Ladeanimation unter dem Logo
for (i = 0; i < 36; i++)
    wave[i] = Image("wave-" + i + ".png");
spinner = Sprite(wave[0]);
spinner.SetX(Math.Int(screen_w / 2 - wave[0].GetWidth() / 2));
spinner.SetY(logo_y + logo_size + 28);
spinner.SetZ(10);

# --- Hinweis unten
based_image = Image("based-on.png");
based = Sprite(based_image);
based.SetX(Math.Int(screen_w / 2 - based_image.GetWidth() / 2));
based.SetY(screen_h - based_image.GetHeight() - Math.Int(screen_h * 0.05));
based.SetZ(10);

frame = 0;
fun refresh_callback()
{
    frame++;
    spinner.SetImage(wave[Math.Int(frame / 2) % 36]);
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Meldungen (z. B. Dateisystemprüfung) und Passwortabfrage (Verschlüsselung)
message_sprite = Sprite();
message_sprite.SetZ(20);
fun message_callback(text)
{
    message_image = Image.Text(text, 0.85, 0.88, 0.95);
    message_sprite.SetImage(message_image);
    message_sprite.SetX(Math.Int(screen_w / 2 - message_image.GetWidth() / 2));
    message_sprite.SetY(spinner.GetY() + 90);
}
Plymouth.SetMessageFunction(message_callback);

prompt_sprite = Sprite();
prompt_sprite.SetZ(30);
bullets_sprite = Sprite();
bullets_sprite.SetZ(30);
fun display_password_callback(prompt, bullets)
{
    prompt_image = Image.Text(prompt, 0.95, 0.96, 0.99);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(Math.Int(screen_w / 2 - prompt_image.GetWidth() / 2));
    prompt_sprite.SetY(spinner.GetY() + 90);
    stars = "";
    for (i = 0; i < bullets; i++)
        stars = stars + "●";
    bullets_image = Image.Text(stars, 0.13, 0.83, 0.93);
    bullets_sprite.SetImage(bullets_image);
    bullets_sprite.SetX(Math.Int(screen_w / 2 - bullets_image.GetWidth() / 2));
    bullets_sprite.SetY(spinner.GetY() + 120);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback()
{
    prompt_sprite.SetImage(Image.Text("", 1, 1, 1));
    bullets_sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
