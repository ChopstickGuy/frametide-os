#!/bin/sh
set -e
if [ "$1" = configure ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
    # Eigenes Schema der Fenster-Layout-Erweiterung (neuer als Ubuntus Systemschema)
    glib-compile-schemas /usr/share/gnome-shell/extensions/tiling-assistant@frametide/schemas || true
    dconf update 2>/dev/null || true
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
    # Frametide-Startbildschirm als Standard (die Initramfs wird beim Build/Installieren neu erzeugt)
    update-alternatives --quiet --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
        /usr/share/plymouth/themes/frametide/frametide.plymouth 200
    update-alternatives --quiet --set default.plymouth /usr/share/plymouth/themes/frametide/frametide.plymouth
fi
