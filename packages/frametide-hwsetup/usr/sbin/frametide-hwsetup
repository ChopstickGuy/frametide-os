#!/usr/bin/python3
"""frametide-hwsetup – erkennt Grafikkarte(n) und CPU und richtet die passenden
Treiber und Einstellungen ein, damit Spiele die volle Leistung der Hardware
abrufen können.

  frametide-hwsetup            Hardware anzeigen und geplante Schritte auflisten
  frametide-hwsetup --apply    Schritte ausführen (root, läuft beim ersten Start)
"""
import argparse
import datetime
import glob
import os
import re
import socket
import subprocess
import time
import sys
from dataclasses import dataclass, field

PCI_ROOT = "/sys/bus/pci/devices"
CONF_FILE = "/etc/frametide/hwsetup.conf"
GRUB_HW_FILE = "/etc/default/grub.d/91-frametide-hw.cfg"
MODPROBE_FILE = "/etc/modprobe.d/frametide-hw.conf"
APT_V3_FILE = "/etc/apt/apt.conf.d/90-frametide-amd64v3"
DONE_FILE = "/var/lib/frametide/hwsetup.done"
LOG_FILE = "/var/log/frametide-hwsetup.log"

VENDORS = {"10de": "nvidia", "1002": "amd", "8086": "intel"}
# CPU-Flags, die x86-64-v3 ausmachen (abm = lzcnt)
X86_64_V3_FLAGS = {"avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "abm", "movbe", "xsave"}


@dataclass
class Gpu:
    slot: str
    vendor: str
    device_id: str
    driver: str | None
    boot_vga: bool
    name: str


@dataclass
class Cpu:
    vendor: str
    model: str
    x86_64_v3: bool


@dataclass
class Plan:
    packages: set = field(default_factory=set)
    packages_i386: set = field(default_factory=set)
    kernel_params: list = field(default_factory=list)
    modprobe: list = field(default_factory=list)
    services: list = field(default_factory=list)
    ubuntu_drivers: bool = False
    amd64v3: bool = False
    notes: list = field(default_factory=list)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def lspci_name(slot):
    try:
        out = subprocess.run(["lspci", "-s", slot], capture_output=True, text=True).stdout
        return out.split(": ", 1)[1].strip() if ": " in out else ""
    except OSError:
        return ""


def detect_gpus(root=PCI_ROOT):
    gpus = []
    for dev in sorted(glob.glob(f"{root}/*")):
        if not read(f"{dev}/class").startswith("0x03"):
            continue
        slot = os.path.basename(dev)
        vendor_id = read(f"{dev}/vendor")[2:]
        driver_link = f"{dev}/driver"
        gpus.append(Gpu(
            slot=slot,
            vendor=VENDORS.get(vendor_id, f"other({vendor_id})"),
            device_id=read(f"{dev}/device")[2:],
            driver=os.path.basename(os.readlink(driver_link)) if os.path.islink(driver_link) else None,
            boot_vga=read(f"{dev}/boot_vga") == "1",
            name=lspci_name(slot),
        ))
    return gpus


def detect_cpu(cpuinfo="/proc/cpuinfo"):
    info = {}
    for line in read(cpuinfo).splitlines():
        if not line.strip():
            break  # erster Kern reicht
        key, _, value = line.partition(":")
        info[key.strip()] = value.strip()
    flags = set(info.get("flags", "").split())
    return Cpu(info.get("vendor_id", "?"), info.get("model name", "?"), X86_64_V3_FLAGS <= flags)


def load_conf(path=CONF_FILE):
    conf = {}
    for line in read(path).splitlines():
        m = re.match(r"\s*([A-Z0-9_]+)\s*=\s*(\S+)", line)
        if m:
            conf[m.group(1)] = m.group(2).strip("\"'").lower()
    return conf


def build_plan(gpus, cpu, conf):
    plan = Plan()
    vendors = {g.vendor for g in gpus}

    # Mesa immer, auch neben NVIDIA (iGPU, Gamescope, Zink). 32-Bit für Steam/Proton.
    plan.packages |= {"mesa-vulkan-drivers", "libgl1-mesa-dri", "mesa-va-drivers", "libvulkan1"}
    plan.packages_i386 |= {"mesa-vulkan-drivers", "libgl1-mesa-dri", "libglx-mesa0", "libvulkan1"}
    plan.packages.add("intel-microcode" if cpu.vendor == "GenuineIntel" else "amd64-microcode")

    if "nvidia" in vendors:
        # ubuntu-drivers wählt den empfohlenen Treiber (open für Turing+, sonst proprietär)
        # und nutzt vorsignierte Kernel-Module -> funktioniert mit Secure Boot ohne MOK.
        plan.ubuntu_drivers = True
        plan.kernel_params += ["nvidia-drm.modeset=1", "nvidia-drm.fbdev=1"]
        plan.modprobe.append(
            "options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp")
        plan.services += ["nvidia-suspend.service", "nvidia-resume.service", "nvidia-hibernate.service"]
        if len(gpus) > 1:
            plan.services += ["nvidia-powerd.service", "switcheroo-control.service"]
            plan.notes.append("Hybrid-Grafik erkannt: Spiele per Rechtsklick → "
                              "„Mit dedizierter Grafikkarte starten“ oder in Steam "
                              "automatisch über PRIME-Offload.")

    if "amd" in vendors:
        legacy = [g for g in gpus if g.vendor == "amd" and g.driver == "radeon"]
        if legacy:
            # GCN 1.0/1.1 laufen sonst auf dem alten radeon-Treiber ohne Vulkan
            plan.kernel_params += ["radeon.si_support=0", "radeon.cik_support=0",
                                   "amdgpu.si_support=1", "amdgpu.cik_support=1"]
            plan.notes.append("Ältere AMD-GPU (GCN 1/2) wird auf amdgpu umgestellt → Vulkan/RADV verfügbar.")
        if conf.get("AMD_OVERDRIVE") == "yes":
            plan.kernel_params.append("amdgpu.ppfeaturemask=0xffffffff")
            plan.notes.append("AMD-Overdrive aktiv: Übertakten/Undervolting in CoreCtrl möglich.")

    if "intel" in vendors:
        plan.packages.add("intel-media-va-driver-non-free")

    if conf.get("AMD64V3") == "yes":
        if cpu.x86_64_v3:
            plan.amd64v3 = True
        else:
            plan.notes.append("AMD64V3=yes, aber die CPU unterstützt x86-64-v3 nicht – übersprungen.")

    if not gpus:
        plan.notes.append("Keine Grafikkarte gefunden (VM?) – nur Basis-Treiber.")
    return plan


def report(gpus, cpu, plan):
    print("Frametide OS – Hardware-Erkennung\n")
    print(f"CPU   {cpu.model} ({cpu.vendor}), x86-64-v3: {'ja' if cpu.x86_64_v3 else 'nein'}")
    for g in gpus:
        primary = " [primär]" if g.boot_vga else ""
        print(f"GPU   {g.slot} {g.vendor:<7} {g.name or g.device_id}  "
              f"Treiber: {g.driver or '-'}{primary}")
    print("\nGeplante Schritte:")
    if plan.ubuntu_drivers:
        print("  • NVIDIA: empfohlenen Treiber über ubuntu-drivers installieren (+ 32-Bit-Bibliotheken)")
    print(f"  • Pakete: {' '.join(sorted(plan.packages))}")
    print(f"  • 32-Bit: {' '.join(sorted(plan.packages_i386))}")
    if plan.kernel_params:
        print(f"  • Kernel-Parameter: {' '.join(plan.kernel_params)}")
    for line in plan.modprobe:
        print(f"  • modprobe: {line}")
    if plan.services:
        print(f"  • Dienste: {' '.join(plan.services)}")
    if plan.amd64v3:
        print("  • x86-64-v3-optimierte Pakete aktivieren (experimentell)")
    for note in plan.notes:
        print(f"  ℹ {note}")


def log(msg):
    line = f"[{datetime.datetime.now():%Y-%m-%d %H:%M:%S}] {msg}"
    print(line, flush=True)
    with open(LOG_FILE, "a") as f:
        f.write(line + "\n")


def run(cmd, check=True):
    log("$ " + " ".join(cmd))
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    proc = subprocess.run(cmd, env=env, capture_output=True, text=True)
    with open(LOG_FILE, "a") as f:
        f.write(proc.stdout + proc.stderr)
    if check and proc.returncode != 0:
        raise RuntimeError(f"Befehl fehlgeschlagen ({proc.returncode}): {' '.join(cmd)}")
    return proc


def write_file(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if read(path) == content.strip():
        return False
    with open(path, "w") as f:
        f.write(content)
    log(f"geschrieben: {path}")
    return True


def wait_for_network(timeout=1800):
    """Wartet (ohne den Systemstart zu blockieren) bis das Ubuntu-Archiv erreichbar ist."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            socket.create_connection(("archive.ubuntu.com", 80), timeout=5).close()
            return True
        except OSError:
            time.sleep(10)
    return False


def installed_nvidia_branches():
    out = run(["dpkg-query", "-W", "-f=${Package} ${Status}\n", "nvidia-driver-*"], check=False).stdout
    return sorted({m.group(1) for m in re.finditer(r"^nvidia-driver-(\d+)\S* install ok installed", out, re.M)})


def apply(plan):
    apt = ["apt-get", "-y", "-o", "Dpkg::Options::=--force-confold"]

    if "i386" not in run(["dpkg", "--print-foreign-architectures"]).stdout.split():
        run(["dpkg", "--add-architecture", "i386"])

    if plan.amd64v3:
        write_file(APT_V3_FILE, 'APT::Architecture-Variants "amd64v3";\n')

    run(["apt-get", "update"])

    if plan.ubuntu_drivers:
        run(["ubuntu-drivers", "install"])
        for branch in installed_nvidia_branches():
            plan.packages_i386.add(f"libnvidia-gl-{branch}")

    run(apt + ["install"] + sorted(plan.packages) + [f"{p}:i386" for p in sorted(plan.packages_i386)])

    if plan.amd64v3:
        run(apt + ["full-upgrade"])

    changed = write_file(MODPROBE_FILE, "".join(f"{l}\n" for l in plan.modprobe)) if plan.modprobe else False
    if plan.kernel_params:
        params = " ".join(plan.kernel_params)
        changed |= write_file(GRUB_HW_FILE, "# Von frametide-hwsetup erzeugt\n"
                              f'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT {params}"\n')

    for service in plan.services:
        run(["systemctl", "enable", service], check=False)

    if changed:
        run(["update-initramfs", "-u", "-k", "all"])
        if os.path.exists("/usr/sbin/update-grub"):
            run(["update-grub"])

    os.makedirs(os.path.dirname(DONE_FILE), exist_ok=True)
    write_file(DONE_FILE, f"{datetime.datetime.now().isoformat()}\n")
    # Ubuntu-Benachrichtigung „Neustart erforderlich“ auslösen
    with open("/run/reboot-required", "w") as f:
        f.write("*** Neustart erforderlich, um die Grafiktreiber zu aktivieren ***\n")
    with open("/run/reboot-required.pkgs", "a") as f:
        f.write("frametide-hwsetup\n")
    log("Fertig – bitte neu starten.")


def main():
    parser = argparse.ArgumentParser(description="Frametide OS Hardware- und Treibereinrichtung")
    parser.add_argument("--apply", action="store_true", help="Schritte ausführen (root)")
    parser.add_argument("--wait-network", action="store_true",
                        help="vor dem Ausführen auf eine Internetverbindung warten")
    parser.add_argument("--sysfs", default=PCI_ROOT, help=argparse.SUPPRESS)
    parser.add_argument("--cpuinfo", default="/proc/cpuinfo", help=argparse.SUPPRESS)
    args = parser.parse_args()

    gpus = detect_gpus(args.sysfs)
    cpu = detect_cpu(args.cpuinfo)
    plan = build_plan(gpus, cpu, load_conf())
    report(gpus, cpu, plan)

    if not args.apply:
        print("\nZum Ausführen: sudo frametide-hwsetup --apply")
        return 0
    if os.geteuid() != 0:
        print("Fehler: --apply benötigt root-Rechte (sudo).", file=sys.stderr)
        return 1
    print()
    if args.wait_network and not wait_for_network():
        log("Keine Internetverbindung – Einrichtung wird beim nächsten Start wiederholt.")
        return 1
    try:
        apply(plan)
    except RuntimeError as e:
        log(f"FEHLER: {e} – Details in {LOG_FILE}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
